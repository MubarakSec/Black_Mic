{
  "name": "black_mic",
  "version": "1.0.0",
  "description": "Use your phone as a high-quality wireless microphone for Linux — lossless PCM over WebSocket into a system-wide virtual PipeWire device.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "test:unit": "vitest run --exclude tests/e2e",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "keywords": [
    "audio",
    "microphone",
    "pulseaudio",
    "pipewire",
    "websocket",
    "pcm",
    "linux"
  ],
  "author": "Black Mic Studio contributors",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "concurrently": "^10.0.3",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
